NODE_ENV=development
PORT=8001

# Local dev default matches docker-compose.yml. On Railway, set this to the
# Postgres plugin's DATABASE_URL variable reference instead.
DATABASE_URL=postgresql://rpm:rpm@localhost:5434/rpm?schema=public

# Comma-separated list of origins allowed to call this API with credentials.
CLIENT_URLS=http://localhost:4000,http://localhost:5173

JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=30d
COOKIE_NAME=rpm_token
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none once frontend/backend are on
# different domains in production (e.g. Vercel + Railway).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# S3-compatible object storage for property/blog images. Leave all four blank
# to fall back to local disk storage under ./uploads (dev only - use a real
# bucket, e.g. a Railway Bucket, once deployed). Variable names match what
# Railway auto-injects when you attach a Bucket with the AWS SDK preset.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=
REGION=auto

# --- Email via connected Gmail accounts (see docs/gmail-setup.md) ---
# Google Cloud OAuth client (Web application). Leave blank to run without email:
# messages are then only logged to the console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# <this backend's public URL>/api/email/google/callback - must also be listed as
# an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8001/api/email/google/callback
# 32 random bytes, base64 - encrypts stored Gmail refresh tokens: openssl rand -base64 32
EMAIL_TOKEN_KEY=
# Optional: admin panel URL used for links in owner emails; where contact-form
# messages go (defaults to the system Gmail); print emails instead of sending.
ADMIN_URL=
CONTACT_TO_EMAIL=
EMAIL_DRY_RUN=false
