generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Guest
  Owner
  SuperAdmin
}

enum PropertyStatus {
  active
  inactive
  draft
}

enum BookingStatus {
  pending
  accepted
  rejected
  booked
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  passwordHash       String
  phone              String?
  picture            String?
  role               UserRole         @default(Guest)
  isVerified         Boolean          @default(false)
  // Deactivated users can't sign in or use an existing session.
  isActive           Boolean          @default(true)
  // Set when a SuperAdmin creates the account or resets its password; the API
  // blocks everything except changing the password until it's cleared.
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  bookings           Booking[]
  ownedProperties    Property[]
  emailConnection    EmailConnection?
  // Trusted-renter access (see OwnerInvite / OwnerGrant below).
  invitesSent        OwnerInvite[]    @relation("InviteOwner")
  invitesClaimed     OwnerInvite[]    @relation("InviteClaimer")
  grantsGiven        OwnerGrant[]     @relation("GrantOwner")
  grantsReceived     OwnerGrant[]     @relation("GrantGuest")
}

model VerificationCode {
  id         String              @id @default(cuid())
  email      String
  code       String
  purpose    VerificationPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      PropertyStatus @default(active)
  // Private properties are hidden from the public site; only the owner,
  // a SuperAdmin and guests holding an OwnerGrant from the owner can see them.
  isPrivate   Boolean        @default(false)

  minNights Int   @default(2)
  maxNights Int?
  guests    Int   @default(2)
  bedrooms  Int   @default(1)
  bathrooms Int   @default(1)
  rating    Float @default(4.9)

  amenities String[]

  locationAddress String?
  locationCity    String?
  locationCountry String?
  locationZipCode String?
  locationUrl     String?

  priceNightly     Int    @default(0)
  priceCurrency    String @default("USD")
  priceCleaningFee Int    @default(0)
  priceServiceFee  Int    @default(0)
  priceTaxRate     Int    @default(0)

  // Payment schedule (see BookingInstallment). Empty paymentTerms = no
  // schedule configured; bookings then use the legacy single paymentStatus
  // flow unchanged. Percentages must sum to 100 (validated in the controller).
  // Each entry: {id, label, percent, dueType: "immediate" | "months_before_checkin"
  // | "days_before_checkin", offset}.
  paymentTerms   Json    @default("[]")
  depositEnabled Boolean @default(false)
  // Flat dollar amount, fixed per property - added to the first-due installment.
  depositAmount  Int     @default(0)
  // Optional paid extras a guest may pick at booking time (linens, bike
  // rentals, ...). Each entry: {id, label, price}. Flat one-time fee, not
  // taxed - see computePricing. A booking snapshots what was picked onto its
  // own selectedAddOns, so editing this list never rewrites past bookings.
  addOns         Json    @default("[]")

  thumbnailUrl String?
  gallery      String[]

  // Owner who manages this property. Null = unassigned (SuperAdmin-only).
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons  Season[]
  bookings Booking[]

  @@index([ownerId])
}

// One row per payment-schedule installment, generated from the property's
// paymentTerms when the owner accepts a booking (a snapshot - later edits to
// the property's terms never rewrite an existing booking's installments).
model BookingInstallment {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order           Int
  label           String
  percent         Float
  amount          Int
  dueDate         DateTime
  // True when the property's flat security deposit was folded into this
  // installment (always the earliest-due one) - depositAmount is that portion,
  // broken out so it can be displayed separately from the percentage amount.
  includesDeposit Boolean   @default(false)
  depositAmount   Int       @default(0)
  paid            Boolean   @default(false)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([bookingId])
}

model Season {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  pricePerNight Int
  dateRanges    Json
  // Stay limits that apply when the check-in night falls in this season.
  // Null = fall back to the property's minimum / no maximum.
  minNights     Int?
  maxNights     Int?
  // Required weekday (0 = Sunday ... 6 = Saturday) for check-in / check-out on
  // stays that start in this season. Null = any day.
  checkInDay    Int?
  checkOutDay   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId])
}

model Booking {
  id        String @id @default(cuid())
  bookingId String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  checkIn     DateTime
  checkOut    DateTime
  adults      Int      @default(1)
  children    Int      @default(0)
  infants     Int      @default(0)
  guests      Int      @default(1)
  totalNights Int

  guestName  String
  guestEmail String
  guestPhone String?
  notes      String?

  pricing        Json
  totalAmount    Int
  // Snapshot of the property's addOns picked for this booking - see Property.addOns.
  selectedAddOns Json @default("[]")

  bookingStatus      BookingStatus @default(pending)
  paymentStatus      PaymentStatus @default(pending)
  cancelledBy        String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments BookingInstallment[]

  @@index([propertyId])
  @@index([userId])
}

// One row per condo complex / deployment. Single-tenant for now: exactly one
// "default" row is created lazily by the site-content controller. Multi-complex
// later means adding rows and resolving the site from the request domain.
model Site {
  id        String   @id @default(cuid())
  slug      String   @unique @default("default")
  name      String   @default("My Property Site")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content SiteContent[]
}

// Homepage content, one JSON blob per section (hero, featureBar, lifestyle,
// nearby, testimonials, trustBand). Missing sections fall back to the defaults
// in src/lib/siteContent.js.
model SiteContent {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  section   String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([siteId, section])
}

// A user's connected Gmail account, used to send email as them through the
// Gmail API. SuperAdmin connections (isSystem) also act as the platform's
// "system sender" for signup codes, contact form and owners who haven't
// connected their own. refreshTokenEnc is AES-256-GCM (see src/lib/crypto.js).
model EmailConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String
  refreshTokenEnc String
  status          String   @default("active") // "active" | "needs_reconnect"
  lastError       String?
  isSystem        Boolean  @default(false)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// One row per send attempt. Bodies are deliberately not stored (guest PII).
model EmailLog {
  id           String   @id @default(cuid())
  kind         String
  toEmail      String
  subject      String
  status       String // "sent" | "failed" | "skipped"
  error        String?
  connectionId String?
  bookingId    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A local attraction / restaurant / activity shown on the public "Things to do"
// page. Complex-wide (not per owner); managed by Super Admins. Category and area
// are free text - the public page groups by whatever exists.
model ThingToDo {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  category        String
  area            String   @default("")
  locationAddress String   @default("")
  locationUrl     String   @default("")
  imageUrl        String   @default("")
  status          String   @default("active") // "active" | "inactive"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

// An owner's emailed invitation to become a "trusted renter". Only a SHA-256
// hash of the token is stored; the raw token exists only in the emailed link.
// Claiming it creates an OwnerGrant.
model OwnerInvite {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation("InviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  claimedBy       User?     @relation("InviteClaimer", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([ownerId])
}

// A guest's standing access to all of an owner's private properties (including
// ones added later). Revoking sets revokedAt; re-claiming an invite reactivates it.
model OwnerGrant {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation("GrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  guestUserId String
  guest       User      @relation("GrantGuest", fields: [guestUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([ownerId, guestUserId])
  @@index([guestUserId])
}
